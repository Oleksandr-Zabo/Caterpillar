<Window x:Class="Caterpillar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Caterpillar.ViewModels"
        Title="Caterpillar" Icon="Icons/icon.ico" Height="760" Width="1200" WindowState="Maximized">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="ForestGreen" CornerRadius="8" Padding="4" Margin="0,0,12,0">
            <ItemsControl ItemsSource="{Binding Cells}"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="{Binding Rows}" Columns="{Binding Cols}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="{Binding DataContext.CellSize, RelativeSource={RelativeSource AncestorType=Window}}"
                              Height="{Binding DataContext.CellSize, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Image Source="pack://siteoforigin:,,,/Icons/apple.png" Stretch="Uniform" Margin="2"
                                   Visibility="{Binding IsApple, Converter={StaticResource BoolToVisibility}}" />
                            <Image Source="pack://siteoforigin:,,,/Icons/caterpillar.png" Stretch="Uniform" Margin="0"
                                   Visibility="{Binding IsHead, Converter={StaticResource BoolToVisibility}}"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <RotateTransform Angle="{Binding DataContext.HeadRotation, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Image.RenderTransform>
                            </Image>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Field" Margin="0,0,0,10">
                    <StackPanel Margin="8">
                        <Button Content="Read data.txt" Command="{Binding ReadFileCommand}" />
                        <TextBlock Text="Animation speed (ms)" Margin="0,8,0,2" />
                        <TextBox Text="{Binding AnimationSpeed, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Steps limit" Margin="0,8,0,2" />
                        <TextBox Text="{Binding StepsLimit, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Algorithms" Margin="0,0,0,10">
                    <StackPanel Margin="8">
                        <Button Content="Start Backtracking" Command="{Binding StartBacktrackingCommand}" />
                        <Button Content="Start Q-Learning" Command="{Binding StartQLearningCommand}" Margin="0,8,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Statistics">
                    <StackPanel Margin="8">
                        <TextBlock Text="{Binding AlgorithmName}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding DecisionTime}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding ExecutingTime}" />
                        <TextBlock Text="{Binding ApplesEaten, StringFormat=Apples eaten: {0}}" />
                        <TextBlock Text="{Binding StepsTaken, StringFormat=Steps: {0}}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>